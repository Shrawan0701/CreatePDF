{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/word-to-pdf.js": {
      "maxDuration": 120,
      "includeFiles": "{server/wordWasm.worker.mjs,node_modules/@matbee/libreoffice-converter/{package.json,wasm/*.{cjs,wasm,data}}}"
    },
    "api/*.js": {
      "maxDuration": 120
    }
  },
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:tool/index.html",
      "destination": "/:tool",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/scan-document",
      "destination": "/scan-document/index.html"
    },
    {
      "source": "/pdf-workflow",
      "destination": "/pdf-workflow/index.html"
    },
    {
      "source": "/merge-pdf",
      "destination": "/merge-pdf/index.html"
    },
    {
      "source": "/alternate-mix",
      "destination": "/alternate-mix/index.html"
    },
    {
      "source": "/compress-pdf",
      "destination": "/compress-pdf/index.html"
    },
    {
      "source": "/split-pdf",
      "destination": "/split-pdf/index.html"
    },
    {
      "source": "/split-by-text",
      "destination": "/split-by-text/index.html"
    },
    {
      "source": "/split-by-bookmarks",
      "destination": "/split-by-bookmarks/index.html"
    },
    {
      "source": "/split-in-half",
      "destination": "/split-in-half/index.html"
    },
    {
      "source": "/split-by-size",
      "destination": "/split-by-size/index.html"
